# Required for live search (free: https://serper.dev). Empty => offline fixtures.
SERPER_API_KEY=
# Optional LLM fallbacks (used only if Ollama is unhealthy)
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: Slack incoming-webhook URL; empty => Slack step is skipped
SLACK_WEBHOOK_URL=
API_PORT=8010
N8N_PORT=5678
MAX_SEARCHES=20
